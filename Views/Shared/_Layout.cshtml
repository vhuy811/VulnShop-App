@using VulnShop.Services
@{
    var user = Context.CurrentUser();
    var cartCount = Context.GetCart().Sum(c => c.Quantity);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VulnShop</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container nav">
            <a class="brand" asp-controller="Home" asp-action="Index">Vuln<span>Shop</span></a>
            <a asp-controller="Product" asp-action="Index">Shop</a>
            <a asp-controller="Order" asp-action="MyOrders">My orders</a>
            <span class="spacer"></span>
            <a class="pill" asp-controller="Cart" asp-action="Index">🛒 Cart <b>@cartCount</b></a>
            @if (user is null)
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            }
            else
            {
                <span class="pill">👤 @user</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="linkbtn">Sign out</button>
                </form>
            }
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            © 2026 VulnShop — a sample ASP.NET Core shop used to exercise the DevSecOps pipeline (SAST, DAST, SCA).
        </div>
    </footer>
</body>
</html>
