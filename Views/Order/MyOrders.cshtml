@model List<VulnShop.Models.Order>
@{ ViewData["Title"] = "My orders"; }

<div class="section-head"><h2>My orders</h2></div>

@if (Model.Count == 0)
{
    <div class="empty">
        <div class="big">📦</div>
        <p>You have no orders yet.</p>
        <a class="btn" asp-controller="Product" asp-action="Index">Start shopping</a>
    </div>
}
else
{
    <table class="tbl">
        <thead>
            <tr><th>Order</th><th>Date</th><th>Ship to</th><th class="right">Total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@o.CreatedAt</td>
                    <td>@o.CustomerName</td>
                    <td class="right">@o.Total.ToString("#,##0")₫</td>
                    <td class="right"><a class="btn ghost sm" asp-controller="Order" asp-action="Details" asp-route-id="@o.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}
